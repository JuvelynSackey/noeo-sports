# Deployment (Phase 12). "production" makes the API refuse to start if
# SECRET_KEY is still the insecure default below.
ENVIRONMENT=development

# Database
# SQLite (local/dev default): sqlite:///./football_prediction.db
# PostgreSQL (production): postgresql+psycopg://user:password@host:5432/football_prediction
DATABASE_URL=sqlite:///./football_prediction.db

# Active data provider: football_data_org | mock
DATA_PROVIDER=mock

# football-data.org (https://www.football-data.org/) — required if DATA_PROVIDER=football_data_org
FOOTBALL_DATA_ORG_API_KEY=
FOOTBALL_DATA_ORG_BASE_URL=https://api.football-data.org/v4

# Display / operational
ADMIN_TIMEZONE=UTC
LOG_LEVEL=INFO

# Refresh intervals (hours) — see MASTER BUILD PROMPT section 13
COMPETITION_DISCOVERY_INTERVAL_HOURS=24
FIXTURE_SYNC_INTERVAL_HOURS=3
RESULT_SYNC_INTERVAL_HOURS=6
DATA_VALIDATION_INTERVAL_HOURS=24
MODEL_MONITORING_INTERVAL_HOURS=24

# Automatic full-sync scheduling (Phase 8) — off by default. When enabled, the
# API process runs FullSyncService on its own in the background every
# FULL_SYNC_INTERVAL_HOURS, in addition to (not instead of) POST /sync.
SCHEDULER_ENABLED=false
FULL_SYNC_INTERVAL_HOURS=6

# Auth (Phase 10)
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# API hardening (Phase 12). CORS is opt-in — leave empty (the default)
# unless a browser-based client needs to call this API cross-origin; format
# is a JSON array, e.g. ["https://admin.example.com"].
CORS_ALLOWED_ORIGINS=[]
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
